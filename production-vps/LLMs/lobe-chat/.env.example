# Compose verification
# Use the safe provider-key template when rendering configs from this example.
LLM_KEYS_ENV_FILE=../all-llm-keys.env.example

# App
# APP_URL is set by compose.local.yml or compose.prod.yml defaults.
ACCESS_CODE=change-me-access-code
NEXT_PUBLIC_SERVICE_MODE=server
KEY_VAULTS_SECRET=change-me-key-vaults-secret

# Auth
AUTH_SECRET=change-me-auth-secret
AUTH_SSO_PROVIDERS=auth0
AUTH_ALLOWED_EMAILS=user@example.com
AUTH_AUTH0_ID=change-me-auth0-client-id
AUTH_AUTH0_SECRET=change-me-auth0-client-secret
AUTH_AUTH0_ISSUER=https://example.auth0.com
AUTH_CLOUDFLARE_ZERO_TRUST_ID=
AUTH_CLOUDFLARE_ZERO_TRUST_SECRET=
AUTH_CLOUDFLARE_ZERO_TRUST_ISSUER=

# Database
POSTGRES_USER=lobechat
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=lobechat
DATABASE_URL=postgres://lobechat:change-me-postgres-password@lobechat-db:5432/lobechat
DATABASE_DRIVER=node

# Integrations: Langfuse
ENABLE_LANGFUSE=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Search
SEARCH_PROVIDERS=searxng
SEARXNG_URL=http://lobechat-search:8080
BOCHA_API_KEY=
SEARXNG_BIND_ADDRESS=0.0.0.0
SEARXNG_PORT=8080
SEARXNG_LIMITER=false
SEARXNG_INSTANCE_NAME=LobeChat SearXNG

# Crawling
CRAWLER_IMPLS=
BROWSERLESS_TOKEN=
BROWSERLESS_STEALTH_MODE=false
BROWSERLESS_BLOCK_ADS=true

# Redis Cache
REDIS_PASSWORD=
REDIS_PREFIX=lobechat
REDIS_DATABASE=0
REDIS_URL=redis://lobechat-redis:6379

# Storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_DOMAIN=
S3_REGION=

# Providers
ANTHROPIC_BETA_HEADERS=

# Local/prod override defaults
LOBECHAT_HOST_PORT=3210
SEARXNG_HOST_PORT=8080
HTTP_GLOBAL_NETWORK=http-global-network
