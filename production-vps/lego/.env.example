# Safe Lego ACME template. Copy to .env on the VPS and fill real values.

LEGO_ENV_FILE=.env.example
LEGO_EMAIL=admin@example.com
LEGO_DNS_PROVIDER=cloudflare
LEGO_DOMAINS=*.mikufancx.cyou
LEGO_DNS_RESOLVERS=1.1.1.1:53
LEGO_DNS_RESOLVER_IP=1.1.1.1
LEGO_RENEW_DAYS=30
# Optional staging endpoint for tests:
# LEGO_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
LEGO_SERVER=

# Cloudflare DNS API token for dns-01 challenges. Use a scoped token in real .env.
CLOUDFLARE_DNS_API_TOKEN=change-me-cloudflare-dns-token
