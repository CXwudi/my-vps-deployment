# One-shot ACME certificate operations with lego.

set dotenv-load := true

compose_file := "compose.yml"

_default:
  @just --justfile {{justfile()}} --list

# Render Compose config without running ACME operations.
config:
  docker compose --env-file .env.example -f {{compose_file}} config

# Create a new certificate using the configured DNS provider and domains.
create-new:
  #!/usr/bin/env bash
  set -euo pipefail

  server_arg=()
  if [[ -n "${LEGO_SERVER:-}" ]]; then
    server_arg=(--server "${LEGO_SERVER}")
  fi

  domain_args=()
  IFS=',' read -ra domains <<< "${LEGO_DOMAINS:?LEGO_DOMAINS must be set}"
  for domain in "${domains[@]}"; do
    domain="${domain## }"
    domain="${domain%% }"
    domain_args+=(--domains "${domain}")
  done

  docker compose -f {{compose_file}} run --rm lego \
    "${server_arg[@]}" \
    --accept-tos \
    --email "${LEGO_EMAIL:?LEGO_EMAIL must be set}" \
    --dns "${LEGO_DNS_PROVIDER:-cloudflare}" \
    "${domain_args[@]}" \
    --dns.resolvers "${LEGO_DNS_RESOLVERS:-1.1.1.1:53}" \
    run

# Renew existing certificates without deleting ACME account data.
refresh-existing:
  #!/usr/bin/env bash
  set -euo pipefail

  server_arg=()
  if [[ -n "${LEGO_SERVER:-}" ]]; then
    server_arg=(--server "${LEGO_SERVER}")
  fi

  domain_args=()
  IFS=',' read -ra domains <<< "${LEGO_DOMAINS:?LEGO_DOMAINS must be set}"
  for domain in "${domains[@]}"; do
    domain="${domain## }"
    domain="${domain%% }"
    domain_args+=(--domains "${domain}")
  done

  docker compose -f {{compose_file}} run --rm lego \
    "${server_arg[@]}" \
    --accept-tos \
    --email "${LEGO_EMAIL:?LEGO_EMAIL must be set}" \
    --dns "${LEGO_DNS_PROVIDER:-cloudflare}" \
    "${domain_args[@]}" \
    --dns.resolvers "${LEGO_DNS_RESOLVERS:-1.1.1.1:53}" \
    renew --days "${LEGO_RENEW_DAYS:-30}" --no-random-sleep

# Remove stopped lego containers and network artifacts, but keep lego-data intact.
cleanup:
  docker compose -f {{compose_file}} down --remove-orphans

# Backward-compatible aliases.
run: create-new
renew: refresh-existing
