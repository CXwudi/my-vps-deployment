# Operations for scheduled Docker volume backups.

compose_file := "compose.yml"

_default:
  @just --justfile {{justfile()}} --list

# Render the Compose config without starting containers.
config:
  docker compose --env-file .env.example -f {{compose_file}} config

# Start the scheduled backup container.
boot:
  docker compose -f {{compose_file}} up -d

# Stop the scheduled backup container.
down:
  docker compose -f {{compose_file}} down

# Show recent backup logs without triggering a backup.
logs lines="100":
  docker compose -f {{compose_file}} logs --tail {{lines}} volume-backup

reboot: down boot
