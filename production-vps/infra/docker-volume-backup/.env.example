# Safe Docker Volume Backup template. Copy to .env on the VPS and fill real values.
# Set both env-file variables to .env in the real .env if you consolidate settings there.

DOCKER_VOLUME_BACKUP_DEFAULT_ENV_FILE=.env.example
DOCKER_VOLUME_BACKUP_GLOBAL_ENV_FILE=.env.example

# External Docker volume names expected by compose.yml.
TTRSS_POSTGRES_DATA_NAME=ttrss-postgres-data
RSSHUB_REDIS_DATA_NAME=rsshub-redis-data
LOBECHAT_PGVECTOR_DATA_NAME=lobechat-db

# Backup schedules and filename prefixes used by runtime config/*.env jobs.
DAILY_CRON_EXPRESSION=0 9 * * *
WEEKLY_CRON_EXPRESSION=0 10 * * 0
MONTHLY_CRON_EXPRESSION=0 11 1 * *
TTRSS_POSTGRES_DATA_BACKUP_FILENAME_DAILY_PREFIX=ttrss-postgres-data-daily
TTRSS_POSTGRES_DATA_BACKUP_FILENAME_WEEKLY_PREFIX=ttrss-postgres-data-weekly
TTRSS_POSTGRES_DATA_BACKUP_FILENAME_MONTHLY_PREFIX=ttrss-postgres-data-monthly
LOBECHAT_PGVECTOR_DATA_BACKUP_FILENAME_DAILY_PREFIX=lobechat-db-daily
LOBECHAT_PGVECTOR_DATA_BACKUP_FILENAME_WEEKLY_PREFIX=lobechat-db-weekly
LOBECHAT_PGVECTOR_DATA_BACKUP_FILENAME_MONTHLY_PREFIX=lobechat-db-monthly
DAILY_BACKUP_RETENTION_IN_DAYS=7
WEEKLY_BACKUP_RETENTION_IN_DAYS=35
MONTHLY_BACKUP_RETENTION_IN_DAYS=180

# Archive and S3-compatible storage settings.
BACKUP_ARCHIVE=/archive
BACKUP_FILENAME_EXPAND=true
AWS_ENDPOINT=https://s3.example.com
AWS_S3_BUCKET_NAME=change-me-bucket
AWS_S3_PATH=vps/docker-volume-backup
AWS_ACCESS_KEY_ID=change-me-access-key-id
AWS_SECRET_ACCESS_KEY=change-me-secret-access-key

# Notifications. Leave empty to disable.
NOTIFICATION_URLS=
NOTIFICATION_LEVEL=error
