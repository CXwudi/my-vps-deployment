# Safe Watchtower template. Copy to .env on the VPS if notification settings are needed.
# Set WATCHTOWER_ENV_FILE=.env in the real .env to make compose load it.

WATCHTOWER_ENV_FILE=.env.example
WATCHTOWER_SCHEDULE=0 22 * * *
WATCHTOWER_SCOPE=none
WATCHTOWER_CLEANUP=true
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_NOTIFICATION_REPORT=false
TZ=America/New_York
