# Operations for the fake/static fallback site entry.

compose_file := "compose.yml"

_default:
  @just --justfile {{justfile()}} --list

# Render the Compose config without starting containers.
config:
  docker compose -f {{compose_file}} config

# Validate nginx configuration in a transient container.
validate:
  docker compose -f {{compose_file}} run --rm fake-site nginx -t

# Start the fake-site entry.
boot:
  docker compose -f {{compose_file}} up -d

# Stop the fake-site entry.
down:
  docker compose -f {{compose_file}} down

reboot: down boot
