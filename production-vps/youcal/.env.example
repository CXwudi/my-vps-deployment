# Safe YouCal one-shot job template. Copy to .env only if host-specific overrides are needed.

YOUCAL_IMAGE=yc-app-cli:1.0.0
YOUCAL_OUTPUT_DIR=../public-files/sub
YOUCAL_CONFIG_DIR=./yc-app-cli
YOUCAL_UID=1000
YOUCAL_GID=1000
YOUCAL_OUTPUT_FILE=/output/my-todo.ics
YOUCAL_CONFIG_FILE=/etc/youcal/my-todo.yml
