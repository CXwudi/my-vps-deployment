# RSSHub production route credentials template.
# Copy to key.env on the VPS and fill only the variables needed by enabled routes.
# Keep key.env out of Git because it may contain cookies, tokens, or API keys.

# Example RSSHub route secrets; add route-specific variables as needed.
DISCUZ_COOKIE=
YOUTUBE_KEY=
GITHUB_ACCESS_TOKEN=
TWITTER_AUTH_TOKEN=
