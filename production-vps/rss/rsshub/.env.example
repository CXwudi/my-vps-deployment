# RSSHub compose-level overrides.
# key.env and test-key.env hold route credentials and are ignored.
RSSHUB_KEY_ENV_FILE=key.env.example
RSSHUB_TEST_KEY_ENV_FILE=test-key.env.example

RSSHUB_HOST_PORT=3900
RSSHUB_INTERNAL_PORT=1200
RSSHUB_NODE_ENV=production
RSSHUB_TIMEZONE=America/New_York
RSSHUB_CACHE_TYPE=redis
RSSHUB_REDIS_URL=redis://rsshub-redis:6379/
PIXIV_BYPASS_CDN=0
ALLOW_USER_HOTLINK_TEMPLATE=true

# compose.local.yml overrides
RSSHUB_LOGGER_LEVEL=debug
RSSHUB_DEBUG_INFO=true

# compose.prod.yml overrides
RSSHUB_PROXY_URI=socks5h://warp-proxy:1080
RSS_GLOBAL_NETWORK=rss-global-network
