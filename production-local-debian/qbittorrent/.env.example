# qBittorrent environment variables — copy to .env and fill in
# WARNING: The qBittorrent password here should be rotated from any previously
# hardcoded or exposed value.

# qBittorrent Web UI password (required)
QBITTORRENT_PASSWORD=

# Ports (defaults match ports.csv)
WEBUI_PORT=3902
TORRENTING_PORT=39001
ADD_TRACKERS_APP_PORT=8080

# Timezone
TZ=America/New_York
