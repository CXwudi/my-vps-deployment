# Nginx Template Configuration
#
# This file defines environment variables used by the nginx service
# to render site-specific configuration templates.
#
# Copy this file to .env and customize the values for your environment.

# Base domain for all services
BASE_DOMAIN=example.com

# Dify service configuration
# Subdomain for the dify service (combines with BASE_DOMAIN)
DIFY_SUBDOMAIN=dify
# Backend upstream URL (include scheme and port, default to http://dify-nginx)
# DIFY_BACKEND=http://dify-nginx

# N8N service configuration
# Subdomain for the n8n service (combines with BASE_DOMAIN)
N8N_SUBDOMAIN=n8n
# Backend upstream URL (include scheme and port, default to http://n8n-main:5678)
# N8N_BACKEND=http://n8n-main:5678
