supported_envs := "local prod"
compose_base := "compose.base.yml"
compose_local := "compose.local.yml"
compose_prod := "compose.prod.yml"
compose_default_env := "upstream.default.env"
compose_override_env := ".env"

refresh-upstream-default ref="1.14.2":
  #!/usr/bin/env bash
  set -euo pipefail

  raw_ref="{{ref}}"
  if [[ "${raw_ref}" == "latest" || "${raw_ref}" == "main" || "${raw_ref}" == "master" ]]; then
    upstream_ref="refs/heads/main"
  else
    upstream_ref="${raw_ref}"
  fi

  url="https://raw.githubusercontent.com/langgenius/dify/${upstream_ref}/docker/.env.example"
  curl -fsSL "${url}" -o "{{compose_default_env}}"
  echo "Updated {{compose_default_env}} from ${url}"

boot env="prod":
  #!/usr/bin/env bash
  set -euo pipefail

  if [[ "{{env}}" == "prod" || "{{env}}" == "env=prod" ]]; then
    compose_files="-f {{compose_base}} -f {{compose_prod}}"
  elif [[ "{{env}}" == "local" || "{{env}}" == "env=local" ]]; then
    compose_files="-f {{compose_base}} -f {{compose_local}}"
  else
    echo "Unsupported environment '{{env}}'. Expected one of: {{supported_envs}}." >&2
    exit 1
  fi

  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} ${compose_files} up -d

down env="prod":
  #!/usr/bin/env bash
  set -euo pipefail

  if [[ "{{env}}" == "prod" || "{{env}}" == "env=prod" ]]; then
    compose_files="-f {{compose_base}} -f {{compose_prod}}"
  elif [[ "{{env}}" == "local" || "{{env}}" == "env=local" ]]; then
    compose_files="-f {{compose_base}} -f {{compose_local}}"
  else
    echo "Unsupported environment '{{env}}'. Expected one of: {{supported_envs}}." >&2
    exit 1
  fi

  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} ${compose_files} down

reboot env="prod": (down env) (boot env)

backup backup_dir="../dify-backups":
  #!/usr/bin/env bash
  set -euo pipefail

  # Accept both `just backup path` and mistaken `just backup backup_dir=path`.
  raw_backup_dir="{{backup_dir}}"
  if [[ "${raw_backup_dir}" == backup_dir=* ]]; then
    backup_dir="${raw_backup_dir#backup_dir=}"
  else
    backup_dir="${raw_backup_dir}"
  fi
  backup_dir="${backup_dir%/}"

  declare -A volume_dirs=(
    [dify-qdrant]="/qdrant/storage"
    [dify-redis]="/data"
    [dify-db]="/var/lib/postgresql/data"
    [dify-api]="/app/api/storage"
    [dify-plugin-daemon]="/app/storage"
  )
  declare -A backup_files=(
    [dify-qdrant]="dify-qdrant.tar"
    [dify-redis]="dify-redis.tar"
    [dify-db]="dify-db.tar"
    [dify-api]="dify-app-storage.tar"
    [dify-plugin-daemon]="dify-plugin-daemon-storage.tar"
  )
  containers=(dify-qdrant dify-redis dify-db dify-api dify-plugin-daemon)

  mkdir -p "${backup_dir}"
  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} -f {{compose_base}} create

  for container in "${containers[@]}"; do
    mount_dir="${volume_dirs[$container]}"
    tar_file="${backup_files[$container]}"
    docker run --rm --volumes-from "${container}" -v "$(pwd)/${backup_dir}:/backup" debian \
      tar cvf "/backup/${tar_file}" "${mount_dir}"
  done

  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} -f {{compose_base}} down
  sudo chown -R "$USER:$USER" "${backup_dir}"
  echo "Backup created successfully in the ${backup_dir} directory."

restore backup_dir="../dify-backups":
  #!/usr/bin/env bash
  set -euo pipefail

  # Accept both `just restore path` and mistaken `just restore backup_dir=path`.
  raw_backup_dir="{{backup_dir}}"
  if [[ "${raw_backup_dir}" == backup_dir=* ]]; then
    backup_dir="${raw_backup_dir#backup_dir=}"
  else
    backup_dir="${raw_backup_dir}"
  fi
  backup_dir="${backup_dir%/}"

  declare -A volume_dirs=(
    [dify-qdrant]="/qdrant/storage"
    [dify-redis]="/data"
    [dify-db]="/var/lib/postgresql/data"
    [dify-api]="/app/api/storage"
    [dify-plugin-daemon]="/app/storage"
  )
  declare -A backup_files=(
    [dify-qdrant]="dify-qdrant.tar"
    [dify-redis]="dify-redis.tar"
    [dify-db]="dify-db.tar"
    [dify-api]="dify-app-storage.tar"
    [dify-plugin-daemon]="dify-plugin-daemon-storage.tar"
  )
  containers=(dify-qdrant dify-redis dify-db dify-api dify-plugin-daemon)

  if [[ ! -d "${backup_dir}" ]]; then
    echo "Error: ${backup_dir} directory not found"
    exit 1
  fi

  for container in "${containers[@]}"; do
    tar_file="${backup_files[$container]}"
    if [[ ! -f "${backup_dir}/${tar_file}" ]]; then
      echo "Error: ${backup_dir}/${tar_file} not found"
      exit 1
    fi
  done

  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} -f {{compose_base}} create

  for container in "${containers[@]}"; do
    mount_dir="${volume_dirs[$container]}"
    tar_file="${backup_files[$container]}"
    docker run --rm --volumes-from "${container}" -v "$(pwd)/${backup_dir}:/backup" debian bash -c \
      "rm -rf ${mount_dir}/* && tar xvf /backup/${tar_file} -C /"
  done

  docker compose --env-file {{compose_default_env}} --env-file {{compose_override_env}} -f {{compose_base}} down
  echo "Backup restoration completed successfully."
