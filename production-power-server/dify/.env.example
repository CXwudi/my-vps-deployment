# === Dify Minimal Configuration ===
# This section is intentionally minimal. We rely on compose.base.yml to provide default values for most settings.
# Reference: https://raw.githubusercontent.com/langgenius/dify/refs/heads/main/docker/.env.example

### dify version
DIFY_VERSION=1.14.0 # disable auto upgrade as Dify is an instable platform
PLUGIN_DAEMON_VERSION=0.6.0-local # need one matching the dify version

### url
INTERNAL_FILES_URL=http://api:5001
# TRIGGER_URL= # overrided in prod and local profile

### app env
SECRET_KEY=<change me>
SENTRY_DSN=
WEB_SENTRY_DSN=${SENTRY_DSN}
API_SENTRY_DSN=${SENTRY_DSN}
PLUGIN_SENTRY_DSN=${SENTRY_DSN}

### shared compose env (values propagated into api/worker)
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
OPENDAL_FS_ROOT=storage
QDRANT_URL=http://qdrant:6333
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
SCARF_NO_ANALYTICS=true

### db env
DB_HOST=db
DB_USERNAME=dify-for-miku-life # used by dify
DB_PASSWORD=<change me>
DB_DATABASE=dify-db
### actual postgres env
# PGUSER=${DB_USERNAME} # removed cause standard practice is to use POSTGRES_XXX variant to init DB
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_DATABASE}
### advance postgres env
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=600000 # 10 minutes, allow long-running transactions for agent execution, but avoid infinite hanging

### redis env
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=<change me>

### Celery env
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

### vector store env (official Qdrant image now supports CJK embeddings)
VECTOR_STORE=qdrant
QDRANT_API_KEY=<change me>

### rag
UPLOAD_FILE_SIZE_LIMIT=100
UPLOAD_FILE_BATCH_LIMIT=50
SINGLE_CHUNK_ATTACHMENT_LIMIT=50
IMAGE_FILE_BATCH_LIMIT=50
ATTACHMENT_IMAGE_FILE_SIZE_LIMIT=10
ETL_TYPE=Unstructured
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
UNSTRUCTURED_API_KEY=
TOP_K_MAX_VALUE=50

### mailing
MAIL_TYPE=resend
RESEND_API_KEY=

### model config
PROMPT_GENERATION_MAX_TOKENS=4095
CODE_GENERATION_MAX_TOKENS=4095

### workflow and agent config
# WORKFLOW_MAX_EXECUTION_STEPS=500
# WORKFLOW_MAX_EXECUTION_TIME=1200
WORKFLOW_CALL_MAX_DEPTH=15
# MAX_VARIABLE_SIZE=204800
WORKFLOW_FILE_UPLOAD_LIMIT=100
# The maximum number of tools that can be used in the agent.
MAX_TOOLS_NUM=25
# Maximum number of Parallelism branches in the workflow
# The maximum number of iterations for agent setting
MAX_ITERATIONS_NUM=30
# Min number of workers for graph engine, set to 2 to enable parallel execution. The new graph engine by default only enable parallel execution for more complex workflows. See https://github.com/langgenius/dify/discussions/26166#discussioncomment-14553346
GRAPH_ENGINE_MIN_WORKERS=2

### sandbox service
SANDBOX_API_KEY=<change me> # actual sandbox env
CODE_EXECUTION_API_KEY=${SANDBOX_API_KEY} # used by dify
# CODE_MAX_NUMBER=9223372036854775807
# CODE_MIN_NUMBER=-9223372036854775808
CODE_MAX_DEPTH=10
# CODE_MAX_PRECISION=20
# CODE_MAX_STRING_LENGTH=80000
CODE_MAX_STRING_ARRAY_LENGTH=300
CODE_MAX_OBJECT_ARRAY_LENGTH=300
CODE_MAX_NUMBER_ARRAY_LENGTH=3000

### plugin daemon
# If this key is changed, DIFY_INNER_API_KEY in plugin_daemon service must also be updated or agent node will fail.
PLUGIN_DIFY_INNER_API_KEY=<change me>
PLUGIN_DAEMON_KEY=<change me>

### nginx
EXPOSE_NGINX_PORT=3901
EXPOSE_NGINX_SSL_PORT=0
NGINX_CLIENT_MAX_BODY_SIZE=0 # disable to rely on dify's file size limit

### docker
COMPOSE_PROFILES=
